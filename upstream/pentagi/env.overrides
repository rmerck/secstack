# pentagi/.env deltas from upstream .env.example (pinned commit in upstream/repos.lock).
# ${KEY} values come from the hardware plan ($SECOPS/configs/stack.conf) and upstream/images.lock.
# Rendered by scripts/render-env.py. @-values are generated fresh; never put real secrets here.

# ---- local inference (Ollama on the host) ----
OLLAMA_SERVER_URL=http://host.docker.internal:11434
OLLAMA_SERVER_MODEL=${CHAT_MODEL}
OLLAMA_SERVER_CONFIG_PATH=/opt/pentagi/conf/ollama.provider.yml
OLLAMA_SERVER_PULL_MODELS_ENABLED=false
OLLAMA_SERVER_LOAD_MODELS_ENABLED=false
# secstack writes these files (scripts/bootstrap-upstream.sh); upstream's example.* files are left alone.
PENTAGI_LLM_SERVER_CONFIG_PATH=./secstack.custom.provider.yml
PENTAGI_OLLAMA_SERVER_CONFIG_PATH=./secstack.ollama.provider.yml
PENTAGI_BEDROCK_CONFIG_PATH=./secstack.bedrock.provider.yml

# ---- embeddings on a second Ollama (port 11435) so they never evict the chat model ----
EMBEDDING_URL=http://host.docker.internal:11435
EMBEDDING_MODEL=${EMBED_MODEL}
EMBEDDING_PROVIDER=ollama

# ---- agent behavior (both required for sub-32B local models) ----
EXECUTION_MONITOR_ENABLED=true
AGENT_PLANNING_STEP_ENABLED=true

# ---- search: self-hosted SearXNG + keyless engines ----
DUCKDUCKGO_ENABLED=true
SPLOITUS_ENABLED=true
SEARXNG_URL=http://searxng:8080
# pentagi always sends language=<this>; SearXNG answers an empty one with 400 ("Empty language
# parameter"), so every web search failed. "all" means no language filter.
SEARXNG_LANGUAGE=all

# ---- scraper ----
# renewable: nothing stores data under the scraper's login, so a weak existing one is replaced.
LOCAL_SCRAPER_USERNAME=@alnum12 renewable
LOCAL_SCRAPER_PASSWORD=@hex24 renewable
SCRAPER_PRIVATE_URL=https://${LOCAL_SCRAPER_USERNAME}:${LOCAL_SCRAPER_PASSWORD}@scraper/
LOCAL_SCRAPER_MAX_CONCURRENT_SESSIONS=4

# ---- loopback-only listeners ----
PENTAGI_LISTEN_IP=127.0.0.1
PENTAGI_LISTEN_PORT=8443
SCRAPER_LISTEN_IP=127.0.0.1
SCRAPER_LISTEN_PORT=9443
PGVECTOR_LISTEN_IP=127.0.0.1
POSTGRES_EXPORTER_LISTEN_IP=127.0.0.1
# pentagi publishes each flow's terminal ports on this address. Not 127.0.0.1: Ollama trusts pages
# served there. secstack adds 127.0.0.2 to lo0 (LaunchDaemon) and the audit requires this value.
DOCKER_PUBLIC_IP=127.0.0.2

# ---- Kali terminals spawn on the scope-firewalled network, without the Docker socket ----
# (a terminal holding the socket could start a container on any network and leave the scope)
DOCKER_NETWORK=pentest-net
DOCKER_INSIDE=false
DOCKER_INSIDE_POLICY_TESTS=false
# Upstream gives every terminal NET_ADMIN, which lets it change its own address and routes. Scans need
# NET_RAW, which Docker grants anyway, and NET_RAW alone is enough to forge ARP replies on pentest-net (a
# shared bridge: see docs/ARCHITECTURE.md, Known limits). HexStrike is on its own bridge for that reason.
DOCKER_NET_ADMIN=false

# ---- secrets ----
COOKIE_SIGNING_SALT=@hex32
PENTAGI_POSTGRES_PASSWORD=@hex24

# ---- DB pools sized for one laptop ----
DATABASE_MAX_OPEN_CONNS=15
DATABASE_MAX_IDLE_CONNS=5
DATABASE_VECTOR_MAX_CONNS=5

# ---- images: pinned in upstream/images.lock; the agent may not pick its own image ----
PENTAGI_IMAGE=${PENTAGI_IMAGE}
PGVECTOR_IMAGE=${PGVECTOR_IMAGE}
SCRAPER_IMAGE=${SCRAPER_IMAGE}
DOCKER_IMAGE_SELECTION_MODE=fixed
DOCKER_DEFAULT_IMAGE_FOR_PENTEST=${KALI_PENTEST_IMAGE}
