# ARTEX/.env deltas from upstream .env.example (pinned commit in upstream/repos.lock).
# ARTEX_SECRET_KEY encrypts credential columns in ARTEX's Postgres. Losing it means the
# existing database won't start. Back up ARTEX/.env (password manager), never commit it.

POSTGRES_PASSWORD=@hex24
ARTEX_SECRET_KEY=@b64_32

# Web UI on loopback only (ARTEX's compose publishes 8787 on ${ARTEX_BIND_ADDR:-127.0.0.1}).
ARTEX_BIND_ADDR=127.0.0.1

# Empty = default (untrusted-output boundary ON since the 0.7 line).
ARTEX_UNTRUSTED_BOUNDARY=
ARTEX_UPDATE_CHECK=0

ARTEX_LLM_PROVIDER=ollama
ARTEX_LLM_BASE_URL=http://host.docker.internal:11434/v1
ARTEX_LLM_MODEL=${CHAT_MODEL}

ARTEX_NOISE_PROFILE=balanced
ARTEX_TARGET_USER_AGENT=
ARTEX_TASK_BUDGET_TOKENS=2000000
ARTEX_TASK_BUDGET_TURNS=400
ARTEX_INTENT_BUDGET_TOKENS=250000
ARTEX_INTENT_BUDGET_TURNS=60
